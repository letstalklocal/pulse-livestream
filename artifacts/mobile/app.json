{
  "expo": {
    "name": "Pulse",
    "slug": "mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.chimba.livestream",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Pulse needs camera access to broadcast live streams.",
        "NSMicrophoneUsageDescription": "Pulse needs microphone access for live streaming audio.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pulse.livestream",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withAndroidBuildFix",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#08080F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4119aa26-5e2a-4825-81e0-9612267f331c"
      },
      "easConfigurationBackup": {
        "cli": {
          "version": ">= 16.0.0",
          "appVersionSource": "local"
        },
        "build": {
          "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
              "buildType": "apk"
            }
          },
          "preview": {
            "distribution": "internal",
            "android": {
              "buildType": "apk"
            }
          },
          "production": {
            "autoIncrement": true
          }
        },
        "submit": {
          "production": {}
        }
      }
    },
    "owner": "eespana"
  }
}
